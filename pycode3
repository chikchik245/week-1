✅ Python Solution

import math

def find_gcd_of_list(arr):
    gcd_result = arr[0]
    for num in arr[1:]:
        gcd_result = math.gcd(gcd_result, num)
    return gcd_result


if _name_ == "_main_":
    n = int(input().strip())
    arr = list(map(int, input().split()))
    print(find_gcd_of_list(arr))


